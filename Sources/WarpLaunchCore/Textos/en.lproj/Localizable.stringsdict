			<key>other</key>
			<string>%lld tabs</string>
		</dict>
	</dict>
	<!-- LaunchConfigWarp, FitxersLaunchWarp i YAMLWarp: el fitxer temporal de Warp -->
	<key>fa %lld bytes i se n'havien escrit %lld: algú l'ha canviat, i no s'esborra</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>it's %#@b@ and %lld had been written: someone changed it, so it isn't deleted</string>
		<key>b</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld byte</string>
			<key>other</key>
