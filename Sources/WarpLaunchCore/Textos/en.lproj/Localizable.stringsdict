<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plurals en anglès (docs/disseny.md, secció 12): la clau és el text en català amb l'especificador. -->
<plist version="1.0">
<dict>
	<!-- Fase F1: la prova de la infraestructura (IdiomaTests) -->
	<key>%lld finestres</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@finestres@</string>
		<key>finestres</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld window</string>
			<key>other</key>
			<string>%lld windows</string>
		</dict>
	</dict>
	<!-- OrdreCLI: errors d'ús -->
	<key>no hi ha cap finestra número %@; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>there's no window number %@; %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>there's %lld</string>
			<key>other</key>
			<string>there are %lld</string>
		</dict>
	</dict>
	<key>no hi ha cap finestra «%@»; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>there's no window “%@”; %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>there's %lld</string>
			<key>other</key>
			<string>there are %lld</string>
		</dict>
	</dict>
	<!-- OrdreCLI: importa i configuracio valida -->
	<key>%lld pestanyes salten els permisos (--dangerously-skip-permissions).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ permissions (--dangerously-skip-permissions).</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab skips</string>
			<key>other</key>
			<string>%lld tabs skip</string>
		</dict>
	</dict>
	<key>%lld pestanyes no s'obririen com diu la configuració (✗).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ as the configuration says (✗).</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab wouldn't open</string>
			<key>other</key>
			<string>%lld tabs wouldn't open</string>
		</dict>
	</dict>
	<key>%lld finestres · %lld pestanyes · %lld amb Claude · %lld només terminal</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@f@ · %#@p@ · %lld with Claude · %lld terminal only</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld window</string>
			<key>other</key>
			<string>%lld windows</string>
		</dict>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab</string>
			<key>other</key>
			<string>%lld tabs</string>
		</dict>
	</dict>
	<key>Resultat: %lld errors, %lld avisos.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Result: %#@e@, %#@a@.</string>
		<key>e</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld error</string>
			<key>other</key>
			<string>%lld errors</string>
		</dict>
		<key>a</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld warning</string>
			<key>other</key>
			<string>%lld warnings</string>
		</dict>
	</dict>
	<key>%lld pestanyes sense ordre (vegeu els errors)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ without a command (see the errors)</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab</string>
			<key>other</key>
			<string>%lld tabs</string>
		</dict>
	</dict>
	<!-- Informe: warp-launch llegeix -->
	<key>Warp: %lld finestres, %lld pestanyes de terminal, %lld amb Claude. Sessions de Claude fora de cap pestanya: %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@f@, %#@p@, %lld with Claude. Claude sessions outside any tab: %lld.</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld window</string>
			<key>other</key>
			<string>%lld windows</string>
		</dict>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld terminal tab</string>
			<key>other</key>
			<string>%lld terminal tabs</string>
		</dict>
	</dict>
	<key>Carpetes: %lld recuperades de l'historial, %lld que ja no existeixen, %lld a la carpeta d'inici (~).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Folders: %#@h@ from history, %#@n@, %lld in the home folder (~).</string>
		<key>h</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld recovered</string>
			<key>other</key>
			<string>%lld recovered</string>
		</dict>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld that no longer exists</string>
			<key>other</key>
			<string>%lld that no longer exist</string>
		</dict>
	</dict>
	<key>Warp: %lld terminals vius, %lld amb Claude. Sessions de Claude fora de Warp: %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@t@, %lld with Claude. Claude sessions outside Warp: %lld.</string>
		<key>t</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld live terminal</string>
			<key>other</key>
			<string>%lld live terminals</string>
		</dict>
	</dict>
	<key>Finestra %@ · %lld pestanyes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Window %@ · %#@p@</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab</string>
			<key>other</key>
			<string>%lld tabs</string>
		</dict>
	</dict>
	<!-- Resum: les xifres, els arguments de l'app i les opcions de Claude -->
	<key>Warp: %lld terminals · %lld sessions de Claude</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@t@ · %#@s@</string>
		<key>t</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
