			<string>%lld live terminals</string>
		</dict>
	</dict>
	<key>Finestra %@ · %lld pestanyes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Window %@ · %#@p@</string>
		<key>p</key>
		<dict>
