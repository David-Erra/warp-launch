			<string>lld</string>
			<key>one</key>
			<string>%lld terminal</string>
			<key>other</key>
			<string>%lld terminals</string>
		</dict>
		<key>s</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Claude session</string>
			<key>other</key>
			<string>%lld Claude sessions</string>
		</dict>
	</dict>
	<key>Warp: %lld finestres · %lld pestanyes · %lld sessions de Claude</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@f@ · %#@p@ · %#@s@</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld window</string>
			<key>other</key>
			<string>%lld windows</string>
		</dict>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld tab</string>
			<key>other</key>
			<string>%lld tabs</string>
		</dict>
		<key>s</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Claude session</string>
