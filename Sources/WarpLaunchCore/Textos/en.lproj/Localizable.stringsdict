<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plurals en anglès (docs/disseny.md, secció 12): la clau és el text en català amb l'especificador. -->
<plist version="1.0">
<dict>
	<!-- Fase F1: la prova de la infraestructura (IdiomaTests) -->
	<key>%lld finestres</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@finestres@</string>
		<key>finestres</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld window</string>
			<key>other</key>
			<string>%lld windows</string>
		</dict>
	</dict>
	<!-- OrdreCLI: errors d'ús -->
	<key>no hi ha cap finestra número %@; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>there's no window number %@; %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>there's %lld</string>
			<key>other</key>
			<string>there are %lld</string>
		</dict>
	</dict>
	<key>no hi ha cap finestra «%@»; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>there's no window “%@”; %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>there's %lld</string>
			<key>other</key>
			<string>there are %lld</string>
		</dict>
	</dict>
	<!-- OrdreCLI: importa i configuracio valida -->
	<key>%lld pestanyes salten els permisos (--dangerously-skip-permissions).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ permissions (--dangerously-skip-permissions).</string>
