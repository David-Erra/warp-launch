	<!-- ExecucioObertura: el resultat d'obrir -->
	<key>S'ha obert «%@» a Warp: %lld pestanyes, %lld amb Claude.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>“%@” opened in Warp: %#@p@, %lld with Claude.</string>
