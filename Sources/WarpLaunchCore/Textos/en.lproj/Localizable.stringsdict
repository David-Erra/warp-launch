	<!-- PlaObertura: els avisos del full d'obrir -->
	<key>la conversa és en %lld projectes de Claude i cap no és el d'aquesta carpeta: en començarà una de nova</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>the conversation is in %#@p@ and none of them is this folder's: it will start a new one</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld Claude project</string>
			<key>other</key>
			<string>%lld Claude projects</string>
		</dict>
	</dict>
	<key>s'engegaran %lld sessions de Claude alhora</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@s@ will start at once</string>
		<key>s</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
