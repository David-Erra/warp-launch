/* Textos de Warp Launch en francès (docs/disseny.md, secció 12). La clau és el text en català, i la
   referència de la traducció, l'anglès (en.lproj). Els plurals són a Localizable.stringsdict. */

/* Fase F1: la prova de la infraestructura (IdiomaTests); a F3, el menú */
"Obre a Warp…" = "Ouvrir dans Warp…";

/* OrdreCLI: l'ajuda del CLI (les ordres i les opcions no es tradueixen) */
"Ús:" = "Utilisation :";
"warp-launch llegeix [--json] [--warp <warp.sqlite>] [--sessions <carpeta>]\n    Finestres i pestanyes obertes a Warp, i la sessió de Claude de cada pestanya." = "warp-launch llegeix [--json] [--warp <warp.sqlite>] [--sessions <dossier>]\n    Fenêtres et onglets ouverts dans Warp, et la session Claude de chaque onglet.";
"warp-launch importa [--json] [--warp <warp.sqlite>] [--sessions <carpeta>] [--desa --config <carpeta>]\n    La configuració que sortiria de Warp ara, amb els avisos. Sense --desa no escriu res.\n    Les pestanyes on no corre Claude queden només terminal, com a l'app; si s'hi activa Claude,\n    tenen les opcions de la plantilla de ~/.config/warp-launch.\n    --desa la desa a <carpeta>, que no pot tenir cap configuració ni ser ~/.config/warp-launch:\n    la configuració real només es crea des de l'app." = "warp-launch importa [--json] [--warp <warp.sqlite>] [--sessions <dossier>] [--desa --config <dossier>]\n    La configuration que donnerait Warp maintenant, avec les avertissements. Sans --desa, n’écrit rien.\n    Les onglets où Claude ne tourne pas restent en terminal uniquement, comme dans l’app ; si on y active\n    Claude, ils prennent les options du modèle de ~/.config/warp-launch.\n    --desa l’enregistre dans <dossier>, qui ne peut contenir aucune configuration ni être ~/.config/warp-launch :\n    la vraie configuration ne se crée que depuis l’app.";
"warp-launch configuracio valida [--config <carpeta>]\n    Errors i avisos de la configuració (per defecte, la de ~/.config/warp-launch)." = "warp-launch configuracio valida [--config <dossier>]\n    Erreurs et avertissements de la configuration (par défaut, celle de ~/.config/warp-launch).";
"warp-launch obre <nom o número de finestra> [--json] [--config <carpeta>] [--warp <warp.sqlite>]\n        [--sessions <carpeta>]\n    Mode de prova: què passaria si s'obrís la finestra a Warp (quines pestanyes ja són obertes, quines\n    s'obririen i com, i el fitxer i l'URL exactes). No escriu ni obre res, tampoc estat.json." = "warp-launch obre <nom ou numéro de fenêtre> [--json] [--config <dossier>] [--warp <warp.sqlite>]\n        [--sessions <dossier>]\n    Mode test : ce qui se passerait si la fenêtre était ouverte dans Warp (quels onglets sont déjà ouverts,\n    lesquels s’ouvriraient et comment, et le fichier et l’URL exacts). N’écrit et n’ouvre rien, pas même estat.json.";
"warp-launch obre <nom o número de finestra> --obre [--config <carpeta>]\n    Obre la finestra a Warp, com el botó «Obre» de l'app: les pestanyes que no són obertes, cadascuna\n    amb el seu Claude. Si Warp és tancat, primer l'obre. No fa res si l'app és oberta." = "warp-launch obre <nom ou numéro de fenêtre> --obre [--config <dossier>]\n    Ouvre la fenêtre dans Warp, comme le bouton « Ouvrir » de l’app : les onglets qui ne sont pas ouverts,\n    chacun avec son Claude. Si Warp est fermé, l’ouvre d’abord. Ne fait rien si l’app est ouverte.";
"warp-launch diagnostica [--json] [--anonimitza]\n    Comprova si Warp i Claude Code encara tenen la forma que l'app llegeix: els terminals de Warp, els\n    fitxers de sessió i les transcripcions de Claude, ~/.claude.json, les taules de warp.sqlite, les\n    versions (comparades amb les provades) i la restauració de sessió de Warp amb el consentiment. Cada\n    comprovació diu bé, avís o error. L'informe és en anglès, per enganxar-lo en una issue de GitHub.\n    --anonimitza treu el nom d'usuari, la carpeta d'inici i els noms de carpeta (en deixa la forma)." = "warp-launch diagnostica [--json] [--anonimitza]\n    Vérifie si Warp et Claude Code ont encore la forme que l’app lit : les terminaux de Warp, les\n    fichiers de session et les transcriptions de Claude, ~/.claude.json, les tables de warp.sqlite, les\n    versions (comparées aux versions testées) et la restauration de session de Warp avec le consentement.\n    Chaque vérification indique OK, avertissement ou erreur. Le rapport est en anglais, pour être collé\n    dans une issue GitHub.\n    --anonimitza retire le nom d’utilisateur, le dossier de départ et les noms de dossier (en garde la forme).";
"Només llegeix Warp (warp.sqlite en només lectura), ~/.claude/sessions i, amb obre i diagnostica, el nom de\nles transcripcions de ~/.claude/projects i les carpetes de confiança de ~/.claude.json. Amb diagnostica,\ntambé l'esquema de warp.sqlite, l'Info.plist de Warp, ~/.warp/settings.toml i preferencies.json. No obre ni tanca res,\nexcepte obre --obre, que obre la finestra i escriu estat.json i el fitxer temporal de Warp (i l'esborra).\nCodis de sortida: 0 correcte; 1 no s'ha pogut llegir, desar o obrir (o, amb --obre, no s'ha vist tot\nobert; amb obre, també si no hi ha cap Warp o Warp Preview no deixa obrir res; amb diagnostica, alguna\ncomprovació ha donat error); 2 la configuració (llegida o importada) té errors, o alguna pestanya no\ns'obriria; 64 ús incorrecte." = "Lit seulement Warp (warp.sqlite en lecture seule), ~/.claude/sessions et, avec obre et diagnostica, le nom\ndes transcriptions de ~/.claude/projects et les dossiers de confiance de ~/.claude.json. Avec diagnostica,\naussi le schéma de warp.sqlite, l’Info.plist de Warp, ~/.warp/settings.toml et preferencies.json. N’ouvre ni ne\nferme rien, sauf obre --obre, qui ouvre la fenêtre et écrit estat.json et le fichier temporaire de Warp (puis le\nsupprime).\nCodes de sortie : 0 succès ; 1 lecture, enregistrement ou ouverture impossible (ou, avec --obre, tout n’a pas été\nvu ouvert ; avec obre, aussi s’il n’y a aucun Warp ou si Warp Preview ne laisse rien ouvrir ; avec diagnostica,\nune vérification a donné une erreur) ; 2 la configuration (lue ou importée) a des erreurs, ou un onglet ne\ns’ouvrirait pas ; 64 utilisation incorrecte.";

