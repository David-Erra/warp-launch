<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Plurals en català (docs/disseny.md, secció 12): la clau és el text amb l'especificador (`t("\(n) finestres")` dona
     «%lld finestres»), i cada plural té `one` i `other` (GuardaTests). -->
<plist version="1.0">
<dict>
	<!-- Fase F1: la prova de la infraestructura (IdiomaTests) -->
	<key>%lld finestres</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@finestres@</string>
		<key>finestres</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld finestra</string>
			<key>other</key>
			<string>%lld finestres</string>
		</dict>
	</dict>
	<!-- OrdreCLI: errors d'ús -->
	<key>no hi ha cap finestra número %@; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>no hi ha cap finestra número %@; n'hi ha %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<key>no hi ha cap finestra «%@»; n'hi ha %lld:</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>no hi ha cap finestra «%@»; n'hi ha %#@n@:</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld</string>
			<key>other</key>
			<string>%lld</string>
		</dict>
	</dict>
	<!-- OrdreCLI: importa i configuracio valida -->
	<key>%lld pestanyes salten els permisos (--dangerously-skip-permissions).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ els permisos (--dangerously-skip-permissions).</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya salta</string>
			<key>other</key>
			<string>%lld pestanyes salten</string>
		</dict>
	</dict>
	<key>%lld pestanyes no s'obririen com diu la configuració (✗).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ com diu la configuració (✗).</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya no s'obriria</string>
			<key>other</key>
			<string>%lld pestanyes no s'obririen</string>
		</dict>
	</dict>
	<key>%lld finestres · %lld pestanyes · %lld amb Claude · %lld només terminal</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@f@ · %#@p@ · %lld amb Claude · %lld només terminal</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld finestra</string>
			<key>other</key>
			<string>%lld finestres</string>
		</dict>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya</string>
			<key>other</key>
			<string>%lld pestanyes</string>
		</dict>
	</dict>
	<key>Resultat: %lld errors, %lld avisos.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Resultat: %#@e@, %#@a@.</string>
		<key>e</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld error</string>
			<key>other</key>
			<string>%lld errors</string>
		</dict>
		<key>a</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld avís</string>
			<key>other</key>
			<string>%lld avisos</string>
		</dict>
	</dict>
	<key>%lld pestanyes sense ordre (vegeu els errors)</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ sense ordre (vegeu els errors)</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya</string>
			<key>other</key>
			<string>%lld pestanyes</string>
		</dict>
	</dict>
	<!-- Informe: warp-launch llegeix -->
	<key>Warp: %lld finestres, %lld pestanyes de terminal, %lld amb Claude. Sessions de Claude fora de cap pestanya: %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@f@, %#@p@, %lld amb Claude. Sessions de Claude fora de cap pestanya: %lld.</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld finestra</string>
			<key>other</key>
			<string>%lld finestres</string>
		</dict>
