			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sessió de Claude</string>
			<key>other</key>
			<string>%lld sessions de Claude</string>
		</dict>
	</dict>
	<key>%lld pestanyes · %lld amb Claude</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@p@ · %lld amb Claude</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
