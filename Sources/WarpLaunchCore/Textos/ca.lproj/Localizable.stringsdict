		</dict>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya</string>
			<key>other</key>
			<string>%lld pestanyes</string>
		</dict>
		<key>s</key>
		<dict>
