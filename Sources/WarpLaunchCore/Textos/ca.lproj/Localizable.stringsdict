			<string>%lld terminal</string>
			<key>other</key>
			<string>%lld terminals</string>
		</dict>
		<key>s</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld sessió de Claude</string>
			<key>other</key>
			<string>%lld sessions de Claude</string>
		</dict>
	</dict>
	<key>Warp: %lld finestres · %lld pestanyes · %lld sessions de Claude</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@f@ · %#@p@ · %#@s@</string>
		<key>f</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld finestra</string>
			<key>other</key>
