		</dict>
	</dict>
	<key>Carpetes: %lld recuperades de l'historial, %lld que ja no existeixen, %lld a la carpeta d'inici (~).</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Carpetes: %#@h@ de l'historial, %#@n@, %lld a la carpeta d'inici (~).</string>
		<key>h</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld recuperada</string>
			<key>other</key>
			<string>%lld recuperades</string>
		</dict>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld que ja no existeix</string>
			<key>other</key>
			<string>%lld que ja no existeixen</string>
		</dict>
	</dict>
	<key>Warp: %lld terminals vius, %lld amb Claude. Sessions de Claude fora de Warp: %lld.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@t@, %lld amb Claude. Sessions de Claude fora de Warp: %lld.</string>
		<key>t</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld terminal viu</string>
			<key>other</key>
			<string>%lld terminals vius</string>
		</dict>
	</dict>
	<key>Finestra %@ · %lld pestanyes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Finestra %@ · %#@p@</string>
		<key>p</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pestanya</string>
			<key>other</key>
			<string>%lld pestanyes</string>
		</dict>
	</dict>
	<!-- Resum: les xifres, els arguments de l'app i les opcions de Claude -->
	<key>Warp: %lld terminals · %lld sessions de Claude</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Warp: %#@t@ · %#@s@</string>
		<key>t</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
