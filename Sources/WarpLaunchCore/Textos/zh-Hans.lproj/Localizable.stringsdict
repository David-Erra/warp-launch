<!-- Plurals en xinès simplificat (docs/disseny.md, secció 12): la clau és el text en català amb l'especificador. Segons CLDR, només «other». -->
<plist version="1.0">
<dict>
	<!-- Fase F1: la prova de la infraestructura (IdiomaTests) -->
	<key>%lld finestres</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@finestres@</string>
		<key>finestres</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld个窗口</string>
		</dict>
	</dict>
	<!-- OrdreCLI: errors d'ús -->
	<key>no hi ha cap finestra número %@; n'hi ha %lld:</key>
